# Backend environment variables

# Local Postgres connection (used when DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=survey_app

# Managed Postgres (Neon/Render) — takes priority over the DB_* vars above
# DATABASE_URL=postgres://user:password@host/dbname

# Secret used to sign admin JWTs (use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_secret

# Seed admin account created by `npm run migrate`
SEED_ADMIN_EMAIL=admin@survey.app
SEED_ADMIN_PASSWORD=admin123

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

PORT=5000
NODE_ENV=development
